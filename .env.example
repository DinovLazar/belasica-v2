# Formspree endpoint for the /kontakt form. Public form action (not a secret) — wired in Phase
# 3.03b and set in .env.local + Vercel (Production + Preview). Leave this template value EMPTY;
# while unset the form renders visibly disabled rather than failing silently (D-2.07-3).
# NEXT_PUBLIC_* is inlined at build time, so changing it on Vercel needs a redeploy to take effect.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# The site's own public origin, no trailing slash. Read by src/lib/site.ts, which feeds
# metadataBase (layout.tsx), robots.ts, sitemap.ts and every canonical URL — one source of truth
# since Phase 3.23 (PL-4).
#
# LEAVE THIS EMPTY. Unset keeps the Vercel origin (https://belasica-v2.vercel.app), which is
# correct until DNS moves: canonical tags and a sitemap advertising a host that does not resolve
# are worse than none. THE CUTOVER IS SETTING THIS ONE VARIABLE ON VERCEL:
#   NEXT_PUBLIC_SITE_URL=https://www.belasicahistory.mk
# NEXT_PUBLIC_* is inlined at build time, so it needs a REDEPLOY, not just a variable change.
# ⚠️ public/llms.txt hardcodes the same origin and must be edited by hand in the same step.
NEXT_PUBLIC_SITE_URL=

# Google Search Console verification token. Optional: while empty, no
# <meta name="google-site-verification"> is emitted at all. Supplying the real value is an owner
# step after the domain cutover — never invent one. Also inlined at build time.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity write token — SECRET, LOCAL ONLY. Used exclusively by the Phase 2.09 ingestion
# script (scripts/ingest/) to create season + photo documents. Editor permission on the
# `production` dataset. Never NEXT_PUBLIC, never committed, never added to Vercel — the site
# itself stays token-free (D-1.04-2). Put the real value in .env.local (git-ignored); leave
# this template empty. The script exits with an error if it is unset when run with --commit.
SANITY_API_WRITE_TOKEN=
